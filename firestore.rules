rules_version = '2';

// Cada pessoa le e escreve apenas o proprio documento. Ninguem le o de
// ninguem — nem quem estiver autenticado. O console do Firebase continua
// vendo tudo, que e por onde o administrador acompanha.
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Qualquer outro caminho: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
